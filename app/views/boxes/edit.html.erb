<% content_for :title, "#{params[:new] ? 'Nouvelle' : 'Modifier'} caisse C#{@box.id} · RE-PLAY" %>

<div class="container py-4">
  <div class="d-flex align-items-center justify-content-between mb-3">
    <% if @box.draft? %>
      <%# Retour pendant la création = fausse manip : le brouillon est supprimé (numéro perdu). %>
      <%= button_to box_path(@box), method: :delete, class: "btn-back-boxes d-flex align-items-center gap-2", "aria-label": "Retour" do %>
        <i class="fa-solid fa-circle-arrow-left" style="font-size:1.8rem;" aria-hidden="true"></i>
        <i class="fa-solid fa-boxes-stacked btn-back-context-icon" style="font-size:1.8rem;" aria-hidden="true"></i>
        <span class="toy-show-title" style="font-size:1.4rem; margin:0;">Nouvelle caisse</span>
      <% end %>
    <% elsif params[:new] %>
      <%= link_to boxes_path, class: "btn-back-boxes d-flex align-items-center gap-2" do %>
        <i class="fa-solid fa-circle-arrow-left" style="font-size:1.8rem;" aria-hidden="true"></i>
        <i class="fa-solid fa-boxes-stacked btn-back-context-icon" style="font-size:1.8rem;" aria-hidden="true"></i>
        <span class="toy-show-title" style="font-size:1.4rem; margin:0;">Nouvelle caisse</span>
      <% end %>
    <% else %>
      <%= link_to box_path(@box), class: "btn-back-boxes", "aria-label": "Retour" do %>
        <i class="fa-solid fa-circle-arrow-left" style="font-size:1.8rem;" aria-hidden="true"></i>
        <i class="fa-solid fa-box btn-back-context-icon" style="font-size:1.8rem;" aria-hidden="true"></i>
      <% end %>
    <% end %>
    <% unless params[:new] %>
      <span class="toy-show-category-badge" style="font-size:2rem; max-width:none;"><i class="fa-solid fa-box me-1"></i>C<%= @box.id %></span>
    <% end %>
  </div>

  <% if params[:new] %>
    <div class="d-flex align-items-center justify-content-center gap-3 mb-3 p-3" style="background:linear-gradient(135deg,rgba(255,107,53,0.08),rgba(255,107,53,0.04)); border-radius:1rem; border:2px dashed rgba(255,107,53,0.35);">
      <div style="text-align:center;">
        <div style="font-size:0.8rem; font-weight:600; color:#6B7280; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.2rem;">Étiqueter la caisse</div>
        <div style="font-size:2.8rem; font-weight:900; color:#FF6B35; line-height:1;">C<%= @box.id %></div>
      </div>
      <i class="fa-solid fa-tag" style="font-size:2rem; color:rgba(255,107,53,0.4);"></i>
    </div>
  <% end %>

  <div class="detail-card p-4">
    <% unless params[:new] %>
      <div class="d-flex align-items-center gap-3 mb-1">
        <h1 class="toy-show-title" style="font-size:1.6rem;">Modifier la caisse C<%= @box.id %></h1>
      </div>
    <% end %>
    <p style="font-size:1.15rem; font-weight:700; color:#1A2B4A; margin-bottom:1rem;"><%= @box.category.name %></p>

    <%= simple_form_for @box, html: { data: { controller: "tri-checklist", tri_checklist_required_value: @box.draft? } } do |f| %>

      <% if @box.errors.any? %>
        <div class="alert alert-danger" role="alert">
          <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i><%= @box.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <%# Catégorie — visible uniquement en edit classique %>
      <% unless params[:new] %>
        <div class="mb-2">
          <%= f.association :category,
              label: false,
              prompt: "Catégorie…",
              input_html: { class: "form-select verify-select" } %>
        </div>
      <% end %>

      <%# Vérifications du TRI : rouges tant qu'elles ne sont pas cochées, vertes ensuite (comme les
          critères du valoriste). À la création, il faut les neuf pour enregistrer. %>
      <div class="tri-checklist mb-3">
        <div class="tri-checklist-head">
          <span><i class="fa-solid fa-clipboard-check me-1" aria-hidden="true"></i>J'ai vérifié ma caisse</span>
          <strong data-tri-checklist-target="count"><%= @box.tri_checks.size %> / <%= QualityCause::TRI_CHECKS.size %></strong>
        </div>
        <div class="tri-checklist-track"><div class="tri-checklist-fill" data-tri-checklist-target="fill"></div></div>
        <input type="hidden" name="box[tri_checks][]" value="">
        <div class="tri-checklist-grid">
          <% QualityCause::TRI_CHECKS.each do |check| %>
            <input type="checkbox" name="box[tri_checks][]" value="<%= check.key %>" id="tri_check_<%= check.key %>"
                   class="condition-toggle-input" data-tri-checklist-target="check" data-action="change->tri-checklist#refresh"
                   <%= 'checked' if @box.tri_checks.include?(check.key) %>>
            <label for="tri_check_<%= check.key %>" class="condition-toggle-label" title="<%= check.help %>">
              <i class="fa-solid <%= check.icon %>" aria-hidden="true"></i>
              <span><%= check.label %></span>
            </label>
          <% end %>
        </div>
        <details class="cause-legend">
          <summary><i class="fa-solid fa-circle-question" aria-hidden="true"></i> <span>Que veulent dire les images ?</span></summary>
          <ul>
            <% QualityCause::TRI_CHECKS.each do |check| %>
              <li><i class="fa-solid <%= check.icon %>" aria-hidden="true"></i><span><strong><%= check.label %></strong> : <%= check.help %></span></li>
            <% end %>
          </ul>
        </details>
      </div>

      <%# Nombre de jouets %>
      <div class="mb-3">
        <%= f.input :nb_toys, label: false, as: :integer,
            input_html: { class: "form-control verify-input", placeholder: "Nombre de jouets" } %>
      </div>

      <div class="d-grid">
        <p class="tri-checklist-hint" data-tri-checklist-target="hint" hidden>
          <i class="fa-solid fa-lock me-1" aria-hidden="true"></i>Je coche les <%= QualityCause::TRI_CHECKS.size %> vérifications pour pouvoir enregistrer.
        </p>
        <button type="submit" class="btn btn-primary btn-lg" aria-label="Enregistrer la caisse" data-tri-checklist-target="submit">
          <i class="fa-solid fa-check" style="font-size:1.5rem; color:white;" aria-hidden="true"></i>
        </button>
      </div>

    <% end %>
  </div>
</div>

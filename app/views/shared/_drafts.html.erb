<%# Brouillons « à terminer » (numéro réservé, formulaire jamais enregistré).
    locals : drafts (jouets ou caisses), kind (:toy ou :box) %>
<% if drafts.any? %>
  <div class="drafts-strip mb-3" aria-label="À terminer">
    <div class="drafts-strip-title">
      <i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>
      <span>À terminer</span>
    </div>
    <div class="drafts-strip-items">
      <% drafts.each do |draft| %>
        <% toy = kind == :toy %>
        <div class="draft-chip">
          <%= link_to (toy ? edit_toy_path(draft, new: true) : edit_box_path(draft, new: true)),
                class: "draft-chip-resume", title: "Terminer" do %>
            <i class="fa-solid <%= toy ? 'fa-gift' : 'fa-box' %>" aria-hidden="true"></i>
            <span class="draft-chip-id"><%= toy ? 'J' : 'C' %><%= draft.id %></span>
            <i class="fa-solid fa-pen" aria-hidden="true"></i>
          <% end %>
          <%= button_to (toy ? toy_path(draft) : box_path(draft)), method: :delete,
                class: "draft-chip-delete", title: "Supprimer", "aria-label": "Supprimer le brouillon",
                form: { style: "display:inline;" } do %>
            <i class="fa-solid fa-trash" aria-hidden="true"></i>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

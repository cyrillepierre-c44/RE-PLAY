<%# Cases à cocher « causes » avec pictogrammes + légende dépliable.
    locals : causes (QualityCause::Cause), name (nom du paramètre), selected (clés cochées), prefix (ids),
             tone (:cq = orange « refus du contrôle », :discard = rouge « écarté »)
    Couleurs : une cause non cochée est neutre (grise) ; le vert et le rouge pâle restent
    réservés aux six critères du jouet. %>
<div class="cause-chips cause-chips--<%= tone %>">
  <% causes.each do |cause| %>
    <% id = "#{prefix}_#{cause.key}" %>
    <input type="checkbox" name="<%= name %>" value="<%= cause.key %>" id="<%= id %>"
           class="condition-toggle-input" <%= 'checked' if selected.include?(cause.key) %>
           <% if cause.criterion %>data-criterion="<%= cause.criterion %>" data-action="change->cause-criteria#sync"<% end %>>
    <label for="<%= id %>" class="condition-toggle-label cause-chip" title="<%= cause.help %>">
      <i class="fa-solid <%= cause.icon %>" aria-hidden="true"></i>
      <span><%= cause.label %></span>
    </label>
  <% end %>
</div>
<details class="cause-legend">
  <summary><i class="fa-solid fa-circle-question" aria-hidden="true"></i> <span>Que veulent dire les images ?</span></summary>
  <ul>
    <% causes.each do |cause| %>
      <li>
        <i class="fa-solid <%= cause.icon %>" aria-hidden="true"></i>
        <span><strong><%= cause.label %></strong> : <%= cause.help %></span>
      </li>
    <% end %>
  </ul>
</details>

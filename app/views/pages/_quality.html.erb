<%# Volet qualité du tableau de bord — chiffres : QualityDashboard. %>
<% q = quality %>
<% s = q.setting %>
<% detail = ->(extra) { dashboard_quality_detail_path({ period: @period, start_date: @start_date, end_date: @end_date }.compact.merge(extra)) } %>
<% frame = { turbo_frame: "quality-detail" } %>
<% short = ->(user) { user&.email&.split("@")&.first || "?" } %>
<% days = ->(value) { value.nil? ? "–" : "#{number_with_precision(value, precision: 1, separator: ',', strip_insignificant_zeros: true)} j" } %>

<section class="quality-dash mb-4" aria-label="Qualité" data-controller="quality-detail" data-action="click->quality-detail#open">

  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <div class="onb-section-title" style="justify-content:flex-start; margin:0;">
      <h2><i class="fa-solid fa-award me-2 text-coral"></i>Qualité · TRI et VALO</h2>
    </div>
    <%= link_to procedure_path("tableau-de-bord"), class: "quality-help-link" do %>
      <i class="fa-solid fa-book-open me-1" aria-hidden="true"></i>Mode d'emploi
    <% end %>
  </div>

  <%# ── En ce moment dans l'atelier (indépendant de la période) ── %>
  <div class="quality-now mb-3">
    <div class="quality-now-title">
      <span><i class="fa-solid fa-bolt me-1" aria-hidden="true"></i>En ce moment dans l'atelier</span>
      <small>Indépendant de la période choisie</small>
    </div>
    <div class="quality-now-grid">
      <%= link_to detail.(scope: "open"), class: "quality-now-tile", data: frame do %>
        <span class="quality-now-value"><%= q.open_checks.size %></span>
        <span class="quality-now-label">non-conformités ouvertes</span>
        <small>CQ refusé, pas encore retraité</small>
      <% end %>
      <%= link_to detail.(scope: "late"), class: "quality-now-tile quality-now-tile--late", data: frame do %>
        <span class="quality-now-value"><%= q.late_checks.size %></span>
        <span class="quality-now-label"><i class="fa-solid fa-circle-exclamation me-1" aria-hidden="true"></i>en rouge</span>
        <small>plus de <%= s.red_after_days %> jours ouvrés</small>
      <% end %>
      <div class="quality-now-tile">
        <span class="quality-now-value"><%= q.oldest_open_days.nil? ? "–" : "#{q.oldest_open_days} j" %></span>
        <span class="quality-now-label">la plus ancienne</span>
        <small>jours ouvrés depuis le refus</small>
      </div>
      <%= link_to toys_path(filter: "arbitrage"), class: "quality-now-tile" do %>
        <span class="quality-now-value"><%= q.arbitrage_count %></span>
        <span class="quality-now-label">à arbitrer</span>
        <small>refusés 2 fois, destination à décider</small>
      <% end %>
    </div>
  </div>

  <%# ── Bon du 1er coup : VALO et TRI ── %>
  <div class="row g-3 mb-3">
    <% [
         { title: "Atelier VALO", value: q.fpy_valo, target: s.target_valo, bad: "NC", total: q.valo_total,
           line: "#{q.valo_ok} validés du 1er coup sur #{q.valo_total} jouets contrôlés sur la période",
           empty: "Aucun jouet contrôlé sur la période." },
         { title: "Atelier TRI", value: q.fpy_tri, target: s.target_tri, bad: "Jetés", total: q.toys_out.size,
           line: "#{q.toys_out.size - q.tri_rejects.size} gardés sur #{q.toys_out.size} jouets sortis des caisses sur la période",
           empty: "Aucun jouet sorti des caisses sur la période." }
       ].each do |card| %>
      <div class="col-12 col-lg-6">
        <div class="detail-card p-4 h-100 quality-card">
          <div class="d-flex justify-content-between flex-wrap gap-2">
            <span class="kpi-group-label"><%= card[:title] %> · Bon du 1er coup</span>
            <span class="quality-target">Objectif : <%= card[:target] %> %</span>
          </div>
          <% if card[:value].nil? %>
            <p class="quality-empty mt-2 mb-0"><%= card[:empty] %></p>
          <% elsif !q.reliable?(card[:total]) %>
            <p class="quality-hero-sub mt-2 mb-1"><%= card[:line] %></p>
            <p class="quality-small-sample mb-0">
              <i class="fa-solid fa-scale-unbalanced me-1" aria-hidden="true"></i>Moins de <%= s.min_sample %> jouets : pas assez pour un pourcentage fiable. Choisissez une période plus longue.
            </p>
          <% else %>
            <div class="d-flex align-items-baseline flex-wrap gap-2 mt-1">
              <span class="quality-hero"><%= card[:value] %> %</span>
              <span class="quality-hero-sub"><%= card[:line] %></span>
            </div>
            <div class="quality-split mt-2" role="img" aria-label="Bon du premier coup <%= card[:value] %> %, objectif <%= card[:target] %> %">
              <div class="quality-split-ok" style="width: <%= card[:value] %>%;"><% if card[:value] >= 25 %><%= card[:value] %> %<% end %></div>
              <% if card[:value] < 100 %>
                <div class="quality-split-ko" style="width: <%= 100 - card[:value] %>%;"><% if card[:value] <= 86 %><%= 100 - card[:value] %> %<% end %></div>
              <% end %>
              <div class="quality-split-target" style="left: <%= card[:target] %>%;"></div>
            </div>
            <p class="quality-gap mt-2 mb-0">
              <% gap = card[:target] - card[:value] %>
              <% if gap.positive? %>
                <i class="fa-solid fa-arrow-trend-up me-1" aria-hidden="true"></i>Il manque <%= gap %> point<%= 's' if gap > 1 %> pour atteindre l'objectif.
              <% else %>
                <i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>Objectif atteint.
              <% end %>
            </p>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%# ── Chiffres clés VALO ── %>
  <div class="row g-2 mb-3">
    <% [
         [q.nc_rate.nil? ? "–" : "#{q.nc_rate} %", "Taux de non-conformité", "refusés au 1er contrôle"],
         [q.problems_count, "Problèmes détectés", "toutes causes, tous tours"],
         [days.(q.rework_delay), "Délai de retraitement", "du refus au retraitement"],
         [days.(q.total_delay), "Délai total", "du refus à la décision finale"],
         [q.second_refusal_rate.nil? ? "–" : "#{q.second_refusal_rate} %", "Taux de 2e refus", "revalorisations ratées"]
       ].each do |value, label, hint| %>
      <div class="col-6 col-md">
        <div class="kpi-card h-100">
          <div class="kpi-value" style="color:#1A2B4A;"><%= value %></div>
          <div class="kpi-label"><%= label %></div>
          <div class="quality-hint"><%= hint %></div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="row g-3 mb-3">
    <%# ── Évolution hebdomadaire ── %>
    <div class="col-12 col-lg-6">
      <div class="detail-card p-4 h-100 quality-card">
        <h3 class="quality-h3">Bon du 1er coup VALO, semaine par semaine</h3>
        <p class="quality-sub">Les <%= QualityDashboard::WEEKS %> dernières semaines complètes ; la semaine en cours n'y est pas. Pointillé = objectif <%= s.target_valo %> %. Touchez un point pour voir les jouets refusés cette semaine-là.</p>
        <% weeks = q.weekly %>
        <% if weeks.all? { |w| w[:fpy].nil? } %>
          <p class="quality-empty mb-0">Pas assez de contrôles par semaine (moins de <%= s.min_sample %>) sur les <%= QualityDashboard::WEEKS %> dernières semaines.</p>
        <% else %>
          <%# Échelle resserrée sur les valeurs (elle ne part pas de zéro : c'est une courbe, on lit l'évolution). %>
          <% low = [weeks.filter_map { |w| w[:fpy] }.min, s.target_valo].min %>
          <% floor = [((low - 6) / 10.0).floor * 10, 0].max %>
          <% span = (100 - floor).to_f %>
          <% x = ->(i) { 70 + i * (470.0 / (weeks.size - 1)) } %>
          <% y = ->(v) { 190 - (v - floor) * 150.0 / span } %>
          <svg viewBox="0 0 560 225" class="quality-trend" role="img"
               aria-label="Bon du premier coup par semaine, objectif <%= s.target_valo %> % : <%= weeks.map { |w| "#{w[:label]} #{w[:fpy] ? "#{w[:fpy]} %" : 'trop peu de contrôles'}" }.join(', ') %>">
            <% [floor, floor + (span / 2).round, 100].each do |tick| %>
              <line x1="52" x2="550" y1="<%= y.(tick) %>" y2="<%= y.(tick) %>" stroke="#EEF0F3" stroke-width="1"></line>
              <% unless (tick - s.target_valo).abs * 150.0 / span < 12 %>
                <text x="46" y="<%= y.(tick) + 4 %>" text-anchor="end" class="quality-trend-axis"><%= tick %> %</text>
              <% end %>
            <% end %>
            <%# L'objectif : un pointillé, et sa valeur en gras sur l'axe (pas d'étiquette au milieu des points). %>
            <line x1="52" x2="550" y1="<%= y.(s.target_valo) %>" y2="<%= y.(s.target_valo) %>" stroke="#1A2B4A" stroke-width="1.5" stroke-dasharray="5 5"></line>
            <text x="46" y="<%= y.(s.target_valo) + 4 %>" text-anchor="end" class="quality-trend-target"><%= s.target_valo %> %</text>
            <polyline fill="none" stroke="#0B7F68" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"
                      points="<%= weeks.each_with_index.filter_map { |w, i| "#{x.(i).round(1)},#{y.(w[:fpy]).round(1)}" if w[:fpy] }.join(' ') %>"></polyline>
            <% weeks.each_with_index do |w, i| %>
              <text x="<%= x.(i) %>" y="215" text-anchor="middle" class="quality-trend-axis"><%= w[:label] %></text>
              <% next unless w[:fpy] %>
              <%# Étiquette au-dessus du point ; en dessous seulement si le pointillé de l'objectif passe juste au-dessus. %>
              <% gap = (y.(w[:fpy]) - y.(s.target_valo)) %>
              <% below = gap.positive? && gap < 26 %>
              <%# Lien SVG : pris en charge par le contrôleur quality-detail (Turbo ne les intercepte pas). %>
              <a href="<%= detail.(week: w[:monday].iso8601) %>"
                 aria-label="<%= w[:label] %> : <%= w[:fpy] %> %, <%= w[:total] %> jouets contrôlés">
                <circle cx="<%= x.(i) %>" cy="<%= y.(w[:fpy]) %>" r="18" fill="transparent"></circle>
                <circle cx="<%= x.(i) %>" cy="<%= y.(w[:fpy]) %>" r="6" fill="#0B7F68" stroke="#FFFFFF" stroke-width="2"></circle>
                <text x="<%= x.(i) %>" y="<%= y.(w[:fpy]) + (below ? 22 : -13) %>" text-anchor="middle" class="quality-trend-value"><%= w[:fpy] %> %</text>
              </a>
            <% end %>
          </svg>
        <% end %>
      </div>
    </div>

    <%# ── Causes VALO ── %>
    <div class="col-12 col-lg-6">
      <div class="detail-card p-4 h-100 quality-card">
        <h3 class="quality-h3">Non-conformités VALO par cause</h3>
        <p class="quality-sub">Du plus fréquent au plus rare. Touchez une barre pour voir les jouets et les commentaires.</p>
        <% if q.cause_rows.empty? %>
          <p class="quality-empty mb-0">Aucun refus au contrôle qualité sur la période.</p>
        <% else %>
          <% q.cause_rows.each do |row| %>
            <%= link_to detail.(cause: row[:cause].key), class: "quality-bar-row", data: frame do %>
              <span class="quality-bar-head">
                <span><i class="fa-solid <%= row[:cause].icon %> me-1" aria-hidden="true"></i><%= row[:cause].label %></span>
                <span><strong><%= row[:count] %></strong> · cumul <%= row[:cumulative] %> % · <%= days.(row[:delay]) %></span>
              </span>
              <span class="quality-bar-track"><span class="quality-bar-fill" style="width: <%= row[:share] %>%;"></span></span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <%# ── VALO par opérateur ── %>
  <div class="detail-card p-4 mb-3 quality-card">
    <% if q.daily? %>
      <h3 class="quality-h3">VALO par opérateur · suivi du jour</h3>
      <p class="quality-sub">La barre montre tout ce que l'opérateur a à reprendre <strong>en ce moment</strong>, quelle que soit la date du refus : c'est son stock, pas celui de la journée choisie. Les trois colonnes de droite, elles, ne comptent que la journée choisie. Le Bon du 1er coup par opérateur se lit sur une semaine ou plus.</p>
    <% else %>
      <h3 class="quality-h3">VALO par opérateur</h3>
      <p class="quality-sub">En taux, pour ne pas pénaliser ceux qui traitent le plus de jouets. Pointillé = objectif <%= s.target_valo %> %. Pas de pourcentage en dessous de <%= s.min_sample %> jouets contrôlés. Délais en jours ouvrés.</p>
    <% end %>
    <% if q.operator_rows.empty? %>
      <p class="quality-empty mb-0">Aucun contrôle sur la période.</p>
    <% elsif q.daily? %>
      <% max_open = [q.operator_rows.map { |row| row[:open] }.max.to_i, 1].max %>
      <p class="quality-legend">
        <span><i class="quality-legend-swatch quality-stock-late" aria-hidden="true"></i>en retard : plus de <%= s.red_after_days %> jours ouvrés</span>
        <span><i class="quality-legend-swatch quality-stock-ontime" aria-hidden="true"></i>dans les délais</span>
      </p>
      <div class="table-responsive">
        <table class="quality-table quality-table--day">
          <thead>
            <tr class="quality-table-groups">
              <td></td>
              <th scope="colgroup">En ce moment</th>
              <th scope="colgroup" colspan="3">Sur la journée choisie</th>
            </tr>
            <tr>
              <th scope="col">Opérateur</th>
              <th scope="col" style="width:46%;">Non-conformités à reprendre</th>
              <th scope="col" class="text-center"><i class="fa-solid fa-rotate-left me-1" aria-hidden="true"></i>Refus reçus</th>
              <th scope="col" class="text-center"><i class="fa-solid fa-check me-1" aria-hidden="true"></i>Retraités</th>
              <th scope="col" class="text-end">Contrôlés</th>
            </tr>
          </thead>
          <tbody>
            <% q.operator_rows.each do |row| %>
              <% on_time = row[:open] - row[:late] %>
              <tr>
                <th scope="row"><%= link_to short.(row[:user]), detail.(operator_id: row[:id]), data: frame %></th>
                <td>
                  <% if row[:open].zero? %>
                    <span class="quality-stock-none"><i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>rien à reprendre</span>
                  <% else %>
                    <div class="quality-stock">
                      <div class="quality-stock-bar" style="width: <%= (row[:open] * 100.0 / max_open).round %>%;"
                           role="img" aria-label="<%= row[:open] %> à reprendre, dont <%= row[:late] %> en retard">
                        <% if row[:late].positive? %><span class="quality-stock-late" style="flex: <%= row[:late] %>;"><%= row[:late] %></span><% end %>
                        <% if on_time.positive? %><span class="quality-stock-ontime" style="flex: <%= on_time %>;"><%= on_time %></span><% end %>
                      </div>
                      <span class="quality-stock-total"><%= row[:open] %></span>
                    </div>
                  <% end %>
                </td>
                <td class="text-center"><%= row[:refused].zero? ? tag.span("–", class: "quality-zero") : tag.strong(row[:refused]) %></td>
                <td class="text-center"><%= row[:reworked].zero? ? tag.span("–", class: "quality-zero") : tag.strong(row[:reworked]) %></td>
                <td class="text-end quality-day-checked"><%= row[:total].zero? ? "–" : "#{row[:ok]} sur #{row[:total]}" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="table-responsive">
        <table class="quality-table">
          <thead>
            <tr>
              <th scope="col">Opérateur</th>
              <th scope="col" style="width:30%;">Bon du 1er coup</th>
              <th scope="col" class="text-end">Contrôlés</th>
              <th scope="col" class="text-end">Refusés</th>
              <th scope="col" class="text-end">Problèmes</th>
              <th scope="col" class="text-end">Délai</th>
              <th scope="col" class="text-end">NC ouvertes</th>
            </tr>
          </thead>
          <tbody>
            <% q.operator_rows.each do |row| %>
              <tr>
                <th scope="row"><%= link_to short.(row[:user]), detail.(operator_id: row[:id]), data: frame %></th>
                <td>
                  <% if row[:reliable] %>
                    <div class="quality-rate">
                      <div class="quality-rate-track">
                        <div class="quality-rate-fill" style="width: <%= row[:fpy] %>%;"></div>
                        <div class="quality-rate-target" style="left: <%= s.target_valo %>%;"></div>
                      </div>
                      <span class="quality-rate-value"><%= row[:fpy] %> %</span>
                    </div>
                  <% elsif row[:total].positive? %>
                    <span class="quality-small-sample" title="Moins de <%= s.min_sample %> jouets contrôlés : pas de pourcentage"><%= row[:ok] %> sur <%= row[:total] %></span>
                  <% else %>
                    <span class="quality-hint">aucun 1er contrôle</span>
                  <% end %>
                </td>
                <td class="text-end"><%= row[:total] %></td>
                <td class="text-end"><%= row[:refused] %></td>
                <td class="text-end"><%= row[:problems] %></td>
                <td class="text-end"><%= days.(row[:delay]) %></td>
                <td class="text-end">
                  <%= row[:open] %>
                  <% if row[:late].positive? %><span class="quality-late"> · <%= row[:late] %> rouge<%= 's' if row[:late] > 1 %></span><% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <%# ── Opérateur × cause ── %>
  <% if q.matrix_rows.any? && q.matrix_causes.any? %>
    <% pct = ->(rate) { "#{number_with_precision(rate, precision: rate < 10 ? 1 : 0, separator: ',', strip_insignificant_zeros: true)} %" } %>
    <div class="detail-card p-4 mb-3 quality-card">
      <h3 class="quality-h3">Qui a besoin d'aide, et sur quoi ?</h3>
      <p class="quality-sub">Problèmes <strong>pour 100 contrôles</strong>, par opérateur et par cause (les <%= q.matrix_causes.size %> causes principales) : un opérateur qui traite beaucoup de jouets n'est pas pénalisé. Plus la case est foncée, plus le taux est élevé. Le petit chiffre est le nombre de problèmes. Touchez une case pour le détail.</p>
      <div class="table-responsive">
        <table class="quality-matrix">
          <thead>
            <tr>
              <td></td>
              <th scope="col">Contrôles</th>
              <% q.matrix_causes.each do |cause| %>
                <th scope="col"><i class="fa-solid <%= cause.icon %>" aria-hidden="true"></i><br><%= cause.label %></th>
              <% end %>
              <th scope="col">Tous problèmes</th>
            </tr>
          </thead>
          <tbody>
            <% q.matrix_rows.each do |row| %>
              <tr class="<%= 'quality-matrix-unreliable' unless row[:reliable] %>">
                <th scope="row"><%= short.(row[:user]) %></th>
                <td class="quality-matrix-total"><%= row[:controls] %></td>
                <% q.matrix_causes.each do |cause| %>
                  <% n = row[:causes][cause.key].to_i %>
                  <% rate = row[:rates][cause.key] %>
                  <% level = rate && q.matrix_max_rate.positive? ? [(rate * 5.0 / q.matrix_max_rate).ceil, 5].min : 0 %>
                  <td class="quality-cell quality-cell--<%= level %>">
                    <% if n.zero? %>
                      <span aria-label="0">·</span>
                    <% else %>
                      <%= link_to detail.(operator_id: row[:id], cause: cause.key), data: frame,
                            "aria-label": (rate ? "#{pct.(rate)}, soit #{n} problème#{'s' if n > 1} sur #{row[:controls]} contrôles" : "#{n} problème#{'s' if n > 1}") do %>
                        <% if rate %><%= pct.(rate) %><small><%= n %></small><% else %><%= n %><% end %>
                      <% end %>
                    <% end %>
                  </td>
                <% end %>
                <td class="quality-matrix-total">
                  <% if row[:problem_rate] %><strong><%= pct.(row[:problem_rate]) %></strong><small><%= row[:problems] %></small><% else %><%= row[:problems] %><% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if q.matrix_rows.any? { |row| !row[:reliable] } %>
        <p class="quality-hint mt-2 mb-0">En gris, sans pourcentage : moins de <%= s.min_sample %> jouets contrôlés sur la période, seul le nombre de problèmes est affiché.</p>
      <% end %>
    </div>
  <% end %>

  <div class="row g-3 mb-3">
    <%# ── TRI par responsable de caisse ── %>
    <div class="col-12 col-lg-7">
      <div class="detail-card p-4 h-100 quality-card">
        <h3 class="quality-h3">TRI par responsable de caisse</h3>
        <p class="quality-sub">La personne qui crée la caisse répond des jouets mis dedans. Un jouet jeté à l'entrée de la VALO pour une cause que le TRI devait écarter compte contre le TRI. Pointillé = objectif <%= s.target_tri %> %.</p>
        <% if q.sorter_rows.empty? %>
          <p class="quality-empty mb-0">Aucun jouet sorti des caisses sur la période.</p>
        <% else %>
          <div class="table-responsive">
            <table class="quality-table">
              <thead>
                <tr>
                  <th scope="col">Responsable</th>
                  <th scope="col" style="width:38%;">Bon du 1er coup</th>
                  <th scope="col" class="text-end">Sortis</th>
                  <th scope="col" class="text-end">Écartés</th>
                </tr>
              </thead>
              <tbody>
                <% q.sorter_rows.each do |row| %>
                  <tr>
                    <th scope="row"><%= link_to short.(row[:user]), detail.(scope: "tri", sorter_id: row[:id]), data: frame %></th>
                    <td>
                      <% if row[:reliable] %>
                        <div class="quality-rate">
                          <div class="quality-rate-track">
                            <div class="quality-rate-fill" style="width: <%= row[:fpy] %>%;"></div>
                            <div class="quality-rate-target" style="left: <%= s.target_tri %>%;"></div>
                          </div>
                          <span class="quality-rate-value"><%= row[:fpy] %> %</span>
                        </div>
                      <% else %>
                        <span class="quality-small-sample" title="Moins de <%= s.min_sample %> jouets : pas de pourcentage"><%= row[:total] - row[:rejected] %> sur <%= row[:total] %></span>
                      <% end %>
                    </td>
                    <td class="text-end"><%= row[:total] %></td>
                    <td class="text-end"><%= row[:rejected] %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>
    </div>

    <%# ── Causes du jet à l'entrée ── %>
    <div class="col-12 col-lg-5">
      <div class="detail-card p-4 h-100 quality-card">
        <h3 class="quality-h3">Jetés à l'entrée de la VALO</h3>
        <p class="quality-sub"><%= q.tri_rejects.size %> comptés contre le TRI, <%= q.valo_rejects.size %> découverts à la VALO (complétude, propreté, langue : le TRI ne les vérifie pas).</p>
        <% if q.discard_rows.empty? %>
          <p class="quality-empty mb-0">Aucun jouet jeté à l'entrée sur la période.</p>
        <% else %>
          <% q.discard_rows.each do |row| %>
            <%= link_to detail.(scope: "tri", cause: row[:cause].key), class: "quality-bar-row", data: frame do %>
              <span class="quality-bar-head">
                <span><i class="fa-solid <%= row[:cause].icon %> me-1" aria-hidden="true"></i><%= row[:cause].label %><%= " · TRI" if row[:cause].tri %></span>
                <strong><%= row[:count] %></strong>
              </span>
              <span class="quality-bar-track"><span class="quality-bar-fill <%= 'quality-bar-fill--muted' unless row[:cause].tri %>" style="width: <%= row[:share] %>%;"></span></span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <%# ── Objectifs (admins) ── %>
  <details class="detail-card p-4 quality-card quality-settings">
    <summary><i class="fa-solid fa-sliders me-2 text-coral" aria-hidden="true"></i>Régler les objectifs</summary>
    <%= form_with model: s, url: quality_setting_path, method: :patch, class: "row g-3 mt-1 align-items-end" do |f| %>
      <div class="col-12 col-md">
        <%= f.label :target_valo, "Bon du 1er coup VALO (%)", class: "filter-label" %>
        <%= f.number_field :target_valo, min: 0, max: 100, class: "form-control verify-input" %>
      </div>
      <div class="col-12 col-md">
        <%= f.label :target_tri, "Bon du 1er coup TRI (%)", class: "filter-label" %>
        <%= f.number_field :target_tri, min: 0, max: 100, class: "form-control verify-input" %>
      </div>
      <div class="col-12 col-md">
        <%= f.label :red_after_days, "Rouge après (jours ouvrés)", class: "filter-label" %>
        <%= f.number_field :red_after_days, min: 1, max: 30, class: "form-control verify-input" %>
      </div>
      <div class="col-12 col-md">
        <%= f.label :min_sample, "Pas de % sous (jouets)", class: "filter-label" %>
        <%= f.number_field :min_sample, min: 1, max: 500, class: "form-control verify-input" %>
      </div>
      <div class="col-12 col-md-auto">
        <button type="submit" class="btn btn-primary w-100" aria-label="Enregistrer les objectifs"><i class="fa-solid fa-check" aria-hidden="true"></i></button>
      </div>
    <% end %>
  </details>

  <%# ── Fenêtre de détail (ouverte au clic sur un chiffre) ── %>
  <div class="modal fade quality-detail-modal" tabindex="-1" aria-label="Détail des jouets" data-quality-detail-target="modal">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-fullscreen-md-down">
      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="period-pill period-pill--print" data-action="quality-detail#print">Imprimer cette liste</button>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
        </div>
        <div class="modal-body">
          <turbo-frame id="quality-detail" data-quality-detail-target="frame">
            <p class="quality-empty mb-0">Chargement…</p>
          </turbo-frame>
        </div>
      </div>
    </div>
  </div>
</section>

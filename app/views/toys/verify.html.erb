<% content_for :title, "Contrôle qualité · Jouet J#{@toy.id} · RE-PLAY" %>

<div class="container py-4">
  <div class="d-flex align-items-center justify-content-between mb-3">
    <%= link_to toy_path(@toy), class: "btn-back-boxes", "aria-label": "Retour" do %>
      <i class="fa-solid fa-circle-arrow-left" aria-hidden="true"></i>
      <i class="fa-solid fa-gift btn-back-context-icon" aria-hidden="true"></i>
    <% end %>
    <span class="toy-show-category-badge" style="font-size:2rem; max-width:none;"><i class="fa-solid fa-gift me-1"></i>J<%= @toy.id %></span>
  </div>

  <div class="verify-header mb-3">
    <h1 class="toy-show-title">
      <i class="fa-solid fa-magnifying-glass me-2"></i>Contrôle qualité
    </h1>
  </div>

  <%= simple_form_for(@toy, url: confirm_verify_toy_path(@toy), method: :patch, html: { data: { controller: "cause-criteria" } }) do |f| %>

    <div class="row g-3">

      <%# ── Photo ── %>
      <div class="col-12 col-md-4">
        <div class="verify-photo-wrap">
          <% if @toy.photo.attached? %>
            <%= image_tag @toy.photo, alt: "Photo du jouet J#{@toy.id}", class: "verify-photo", id: "photo-preview-img" %>
          <% else %>
            <div class="verify-no-photo" id="photo-preview-img">
              <i class="fa-solid fa-image"></i>
            </div>
          <% end %>
        </div>
      </div>

      <%# ── Champs & conditions ── %>
      <div class="col-12 col-md-8">

        <%# Conditions toggle %>
        <div class="verify-conditions mb-3">
          <input type="hidden" name="toy[french]" value="0">
          <input type="checkbox" name="toy[french]" value="1" id="toggle-french" class="condition-toggle-input" <%= 'checked' if @toy.french? %>>
          <label for="toggle-french" class="condition-toggle-label">
            <i class="fa-solid fa-flag"></i>
            <span>Français</span>
          </label>

          <input type="hidden" name="toy[ce_mark]" value="0">
          <input type="checkbox" name="toy[ce_mark]" value="1" id="toggle-ce-mark" class="condition-toggle-input" <%= 'checked' if @toy.ce_mark? %>>
          <label for="toggle-ce-mark" class="condition-toggle-label">
            <i class="fa-solid fa-award"></i>
            <span>CE / Marque</span>
          </label>

          <input type="hidden" name="toy[safe]" value="0">
          <input type="checkbox" name="toy[safe]" value="1" id="toggle-safe" class="condition-toggle-input" <%= 'checked' if @toy.safe? %>>
          <label for="toggle-safe" class="condition-toggle-label">
            <i class="fa-solid fa-lock"></i>
            <span>Sécurité</span>
          </label>

          <input type="hidden" name="toy[complete]" value="0">
          <input type="checkbox" name="toy[complete]" value="1" id="toggle-complete" class="condition-toggle-input" <%= 'checked' if @toy.complete? %>>
          <label for="toggle-complete" class="condition-toggle-label">
            <i class="fa-solid fa-list-check"></i>
            <span>Complet</span>
          </label>

          <input type="hidden" name="toy[playable]" value="0">
          <input type="checkbox" name="toy[playable]" value="1" id="toggle-playable" class="condition-toggle-input" <%= 'checked' if @toy.playable? %>>
          <label for="toggle-playable" class="condition-toggle-label">
            <i class="fa-solid fa-gamepad"></i>
            <span>Jouable</span>
          </label>

          <input type="hidden" name="toy[clean]" value="0">
          <input type="checkbox" name="toy[clean]" value="1" id="toggle-clean" class="condition-toggle-input" <%= 'checked' if @toy.clean? %>>
          <label for="toggle-clean" class="condition-toggle-label">
            <i class="fa-solid fa-soap"></i>
            <span>Propre</span>
          </label>
        </div>

        <%# Catégorie %>
        <div class="mb-2">
          <%= f.association :category,
              label: false,
              prompt: "Catégorie…",
              collection: Category.for_toys,
              input_html: { class: "form-select verify-select" } %>
        </div>

        <%# Barcode + Prix côte à côte %>
        <div class="row g-2 mb-1">
          <div class="col-6">
            <div style="font-size:0.75rem; color:#6B7280; margin-bottom:0.2rem;">Facultatif</div>
            <%= f.input :barcode,
                label: false,
                placeholder: "Code-barres",
                input_html: { class: "form-control verify-input" } %>
          </div>
          <div class="col-6">
            <div style="font-size:0.75rem; color:#6B7280; margin-bottom:0.2rem;"><i class="fa-solid fa-robot" style="font-size:0.7rem;"></i> Suggéré par IA</div>
            <%= f.input :price,
                label: false,
                as: :string,
                placeholder: "Prix €",
                input_html: { class: "form-control verify-input", value: @toy.price.present? ? "#{@toy.price} €" : nil } %>
          </div>
        </div>

        <%# Emplacement %>
        <div class="mb-3" style="margin-top:-0.5rem;">
          <div style="font-size:0.75rem; color:#6B7280; margin-bottom:0.2rem;">Emplacement (pour la mise en vente)</div>
          <%= f.input :location,
              label: false,
              required: false,
              placeholder: "Lieu de stockage : Rack A, Étagère 0…",
              input_html: { class: "form-control verify-input", value: (@toy.location unless @toy.location == "En attente de validation") } %>
        </div>

        <% input = @quality_input || { causes: [], comment: nil } %>
        <% round = @control.round %>

        <% if @toy.errors.any? %>
          <div class="alert alert-danger" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>
            <%= @toy.errors.full_messages.to_sentence %>
          </div>
        <% end %>

        <%# Tours précédents — grisés, lecture seule %>
        <%= render "toys/quality_history", toy: @toy %>

        <div class="quality-round mb-3">
          <div class="quality-round-title">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <%= round == QualityCheck::ARBITRATION_ROUND ? "Arbitrage : 2 refus, où va ce jouet ?" : "#{round == 1 ? '1er' : '2e'} tour" %>
          </div>

          <%# Note de l'opérateur pour ce tour — lecture seule %>
          <% unless @toy.arbitrage? %>
            <div class="quality-round-label"><i class="fa-solid fa-microphone" aria-hidden="true"></i> Note de l'opérateur</div>
            <div class="quality-round-text <%= 'is-empty' if @toy.operator_note.blank? %>"><%= @toy.operator_note.presence || "Aucun commentaire" %></div>

            <div class="quality-round-label mt-2"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> Problèmes détectés (en cas de refus)</div>
            <%= render "shared/cause_chips", causes: QualityCause::CQ, name: "quality[causes][]", selected: input[:causes], prefix: "cq_cause", tone: :cq %>
          <% end %>

          <label for="cq_comment_field" class="quality-round-label mt-2">
            <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
            Commentaire du contrôle qualité ·
            <%= @control.comment_required_to_accept? ? "obligatoire" : "obligatoire sauf mise en vente" %>
          </label>
          <%= text_area_tag "quality[comment]", input[:comment],
                id: "cq_comment_field", rows: 3, class: "form-control verify-input",
                placeholder: "Vide — à remplir par le contrôle qualité" %>
        </div>

        <%# Boutons décision %>
        <div class="verify-decisions">
          <%= button_tag name: :status, value: "market", class: "verify-btn verify-btn-market" do %>
            <i class="fa-solid fa-store"></i>
            <span><%= @toy.arbitrage? ? "Vendre en l'état" : "Mise en vente" %></span>
          <% end %>
          <% unless @toy.arbitrage? %>
            <%= button_tag name: :status, value: "review", class: "verify-btn verify-btn-review" do %>
              <i class="fa-solid fa-rotate-left"></i>
              <span><%= round == 2 ? "Refuser (2e fois)" : "Revaloriser" %></span>
            <% end %>
          <% end %>
        </div>
        <div class="verify-decisions mt-2">
          <%= button_tag name: :status, value: "vrac", class: "verify-btn verify-btn-vrac" do %>
            <i class="fa-solid fa-puzzle-piece"></i>
            <span>Vrac</span>
          <% end %>
          <%= button_tag name: :status, value: "don", class: "verify-btn verify-btn-don" do %>
            <i class="fa-solid fa-hand-holding-heart"></i>
            <span>Don</span>
          <% end %>
          <%= button_tag name: :status, value: "suppr", class: "verify-btn verify-btn-suppr",
              data: { turbo_confirm: "Jeter ce jouet ?" } do %>
            <i class="fa-solid fa-trash"></i>
            <span>Jeter</span>
          <% end %>
        </div>

      </div>
    </div>

  <% end %>

  <%= render "toys/reassign", toy: @toy %>
</div>


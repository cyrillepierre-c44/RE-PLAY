<% content_for :title, "#{new_flow? ? 'Nouveau' : 'Modifier'} jouet J#{@toy.id} · RE-PLAY" %>

<div class="container py-4">
  <% if @toy.draft? %>
    <%# Retour pendant la création = fausse manip : le brouillon est supprimé (numéro perdu). %>
    <%= button_to toy_path(@toy), method: :delete, class: "btn-back-boxes mb-3", "aria-label": "Retour",
          form: { class: "d-inline-block" } do %>
      <i class="fa-solid fa-circle-arrow-left" aria-hidden="true"></i>
      <i class="fa-solid fa-box btn-back-context-icon" aria-hidden="true"></i>
    <% end %>
  <% elsif new_flow? %>
    <%= link_to box_path(@toy.box), class: "btn-back-boxes mb-3 d-inline-block", "aria-label": "Retour" do %>
      <i class="fa-solid fa-circle-arrow-left" aria-hidden="true"></i>
      <i class="fa-solid fa-box btn-back-context-icon" aria-hidden="true"></i>
    <% end %>
  <% else %>
    <%= link_to toy_path(@toy), class: "btn-back-boxes mb-3 d-inline-block", "aria-label": "Retour" do %>
      <i class="fa-solid fa-circle-arrow-left" aria-hidden="true"></i>
      <i class="fa-solid fa-gift btn-back-context-icon" aria-hidden="true"></i>
    <% end %>
  <% end %>


  <div class="detail-card p-4">
    <div class="d-flex align-items-center gap-3 mb-1">
      <h1 class="toy-show-title" style="font-size:1.6rem;"><%= new_flow? ? 'Nouveau jouet' : "Modifier le jouet" %> J<%= @toy.id %></h1>
    </div>
    <% if @toy.category %>
      <p style="font-size:1.15rem; font-weight:700; color:#1A2B4A; margin-bottom:1rem;"><%= @toy.category.name %></p>
    <% end %>

    <%= render "form" %>
  </div>
</div>
